# 環境變量範例：複製成 .env 後再修改（.env 不會提交到 Git）
# 所有變量都有本機開發用的預設值，本機開發可以不建立 .env

# ===== 後端（Spring Boot）=====
SERVER_PORT=8088
MONGODB_URI=mongodb://localhost:27018/marksixlab?directConnection=true
REDIS_HOST=localhost
REDIS_PORT=6380
# 允許連 WebSocket 的前端來源，多個用逗號分隔；用區網 IP 開前端（例如手機測試）時要加上，例如：
# CORS_ALLOWED_ORIGINS=http://localhost:3100,http://192.168.0.171:3100
CORS_ALLOWED_ORIGINS=http://localhost:3100
# JWT 簽名密鑰（階段 1 做登入時加入，至少 32 個字符；上線必須換掉）
JWT_SECRET=dev-only-secret-please-change-me-0123456789

# ===== 前端（Next.js）=====
# 伺服器端轉發 /api/* 的目標（next.config.ts 的 rewrites）
BACKEND_URL=http://localhost:8088
# 瀏覽器直連後端的 WebSocket 位址。本機開發**不要設定**：前端會自動用目前頁面的主機名稱 + 8088
#（用 localhost 開就連 localhost，用區網 IP 開就連區網 IP）；寫死 localhost 的話，用區網 IP 開時會連不上
# NEXT_PUBLIC_WS_URL=wss://api.example.com/ws

# ===== 上線（帳號開好後再填，不要寫進本機的 .env）=====
# 步驟見 docs/deploy.md。密鑰填在 Vercel / Render 的 Dashboard，不要提交到 Git。
#
# --- Render（後端）---
# SPRING_PROFILES_ACTIVE=cloud
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/marksixlab?retryWrites=true&w=majority
#   Atlas 的連線字串不要加 directConnection=true。密碼裡的特殊字元要先做 URL encode
# REDIS_HOST=xxxx.upstash.io
# REDIS_PORT=6379
# REDIS_USERNAME=default
# REDIS_PASSWORD=Upstash 的密碼
# JWT_SECRET=至少 32 個字元的隨機字串
# COOKIE_SECURE=true
# CORS_ALLOWED_ORIGINS=https://你的專案.vercel.app
#   給 WebSocket 握手對來源用。多個網址用逗號分隔、不要空格
#
# --- Vercel（前端）---
# 這兩個在 build 時寫進程式，改了要重新部署
# BACKEND_URL=https://30-lab-api.onrender.com
# NEXT_PUBLIC_WS_URL=wss://30-lab-api.onrender.com/ws
#
# --- 自己電腦上的機器人 ---
# BASE_URL=https://30-lab-api.onrender.com
# BOT_COUNT=15
# QUIET=1
